# The key every viewer's marks, tokens and object names are derived from. Make one with: python -m leaktrace keygen
# Keep it secret and never change it for titles already published (their copies could no longer be traced).
LEAKTRACE_SECRET=
# Bearer token for the admin API and the UI.
LEAKTRACE_ADMIN_TOKEN=
# Your organisation's name, used in the takedown notice a trace drafts ("... reproduces <org>'s copyrighted title").
# LEAKTRACE_ORG=

# Where titles, masters, CMAF objects and reports are stored (large). Defaults to ./var/data
# LEAKTRACE_DATA=

# Packaging
# LEAKTRACE_SEGMENT_SECONDS=2.0          # segments are whole frames, as close to this as the frame rate allows
# LEAKTRACE_MAX_HEIGHT=1080              # cap on a title's short side (never upscaled)
# LEAKTRACE_LADDER=1080:5000,720:3000,480:1500,360:800   # rungs as short side:kbps; rungs above a title are skipped
# LEAKTRACE_PRESET=medium                # x264 preset for packaging through the API
# LEAKTRACE_MAX_UPLOAD_MB=4096

# Per-viewer manifests (/pl/...) list objects under this base URL: your CDN in front of the bucket holding each
# title's cmaf/ folder at /<title>/. Defaults to this server's own /media.
# LEAKTRACE_MEDIA_URL=https://media.example.com

# Telegram watcher (python -m leaktrace watch ...): from my.telegram.org, for your own account
# LEAKTRACE_TG_API_ID=
# LEAKTRACE_TG_API_HASH=
# LEAKTRACE_WEBHOOK=                     # POSTed a JSON summary when a watched post is identified or narrowed

# ffmpeg/ffprobe if they aren't on PATH
# LEAKTRACE_FFMPEG=
# LEAKTRACE_FFPROBE=
