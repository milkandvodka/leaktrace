# The key every student's marks are derived from. Make one with: python -m leaktrace keygen
# Keep it secret and never change it for lectures already published (old copies could no longer be traced).
LEAKTRACE_SECRET=
# Bearer token for the admin API and UI.
LEAKTRACE_ADMIN_TOKEN=
# Where lectures, renditions and reports are stored (large). Defaults to ./var/data
# LEAKTRACE_DATA=
# ffmpeg/ffprobe if they aren't on PATH
# LEAKTRACE_FFMPEG=
# LEAKTRACE_FFPROBE=
